{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pepehub-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pepehub-sync",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
