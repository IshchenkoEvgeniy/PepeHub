import { Modal, Notice, TFile } from 'obsidian';
import type HabitTimerPlugin from '../main';
import { equalValue } from './pepehub-metadata';
import { type ActivityRecord, type ActivityEntry } from './pepehub-activity';
import { emptyActivityState, captureActivity, pendingActivity, receiptActivity, receiveActivity, type ActivityState } from './pepehub-activity-state';
import { applyActivityMarkdown, readActivityMarkdown } from './pepehub-activity-markdown';
import type { MetadataSnapshot } from './pepehub-metadata';

export class PepeHubActivityService {
  private lastNotice='';
  private busy=false;
  constructor(private plugin:HabitTimerPlugin) {}
  private async statePath(seed?:string):Promise<string> {
    const base=(this.plugin.settings.cloudflareWorkerUrl || '').trim().replace(/\/+$/,'');
    const bytes=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(seed ?? `${base}\n${this.plugin.settings.cloudflareApiToken}`));
    const hash=Array.from(new Uint8Array(bytes),b=>b.toString(16).padStart(2,'0')).join('');
    const directory=this.plugin.manifest.dir ?? `${this.plugin.app.vault.configDir}/plugins/${this.plugin.manifest.id}`;
    return `${directory}/pepehub-activity-${hash}.json`;
  }
  private async readState(path:string):Promise<ActivityState> {
    const adapter=this.plugin.app.vault.adapter;
    if(!await adapter.exists(path))return emptyActivityState();
    const state=JSON.parse(await adapter.read(path)) as ActivityState;
    if(state.version!==1||!state.slots||!Number.isSafeInteger(state.cursor))throw new Error('Invalid PepeHub journal state; existing state was preserved.');
    return state;
  }
  private async save(path:string,state:ActivityState):Promise<void> {
    // A completed write is required before requests or cursor acknowledgement.
    await this.plugin.app.vault.adapter.write(path,JSON.stringify(state));
  }
  async sync(snapshot:MetadataSnapshot,request:(path:string,body?:unknown)=>Promise<unknown>,seed?:string):Promise<void> {
    if(this.busy)return;
    this.busy=true;
    try {await this.exchange(snapshot,request,seed);} finally {this.busy=false;}
  }
  private async exchange(snapshot:MetadataSnapshot,request:(path:string,body?:unknown)=>Promise<unknown>,seed?:string):Promise<void> {
    const path=await this.statePath(seed),state=await this.readState(path),entries:ActivityEntry[]=[];
    const items=new Map(snapshot.items.map(item=>[item.id,item]));
    // Restore deferred imports before observing deletions in a returning note.
    for(const slot of Object.values(state.slots)) {
      if(!slot.needsWrite||slot.conflict)continue;
      const item=items.get(slot.value.itemId);if(!item)continue;
      const file=this.plugin.app.vault.getAbstractFileByPath(item.path);if(!(file instanceof TFile))continue;
      let applied=false;await this.plugin.app.vault.process(file,content=>{const result=applyActivityMarkdown(content,slot.value,slot.writeBase ?? null);applied=result.applied;return result.content;});
      if(applied){delete slot.needsWrite;delete slot.writeBase;}
      else {const current=readActivityMarkdown(await this.plugin.app.vault.read(file),item.id,item.mediaType,false).entries.find(e=>e.id===slot.value.id);slot.conflict={entry:slot.value,revision:slot.revision,sequence:0};slot.value=current ?? {...slot.value,deleted:true};}
      await this.save(path,state);
    }
    for(const item of snapshot.items) {
      const file=this.plugin.app.vault.getAbstractFileByPath(item.path);
      if(!(file instanceof TFile))continue;
      const original=await this.plugin.app.vault.read(file),preview=readActivityMarkdown(original,item.id,item.mediaType);
      if(preview.content===original)entries.push(...preview.entries);
      else await this.plugin.app.vault.process(file,content=>{
        const parsed=readActivityMarkdown(content,item.id,item.mediaType);
        entries.push(...parsed.entries);return parsed.content;
      });
    }
    captureActivity(state,entries,new Set(items.keys()));
    const operations=pendingActivity(state).filter(op=>items.has(op.entry.itemId));await this.save(path,state);
    for(let at=0;at<operations.length;at+=20) {
      const response=await request('/activity',{operations:operations.slice(at,at+20)}) as {version:number;receipts:Parameters<typeof receiptActivity>[1][]};
      if(response.version!==1||!Array.isArray(response.receipts))throw new Error('Invalid PepeHub journal receipts');
      for(const receipt of response.receipts)receiptActivity(state,receipt);
      await this.save(path,state);
    }
    while(true) {
      const page=await request(`/activity?after=${state.cursor}`) as {version:number;records:ActivityRecord[];cursor:number;hasMore:boolean};
      if(page.version!==1||!Array.isArray(page.records)||!Number.isSafeInteger(page.cursor)||page.cursor<state.cursor||(page.hasMore&&page.cursor===state.cursor))throw new Error('Invalid PepeHub journal page');
      for(const record of page.records) {
        const item=items.get(record.entry.itemId);
        const file=item?this.plugin.app.vault.getAbstractFileByPath(item.path):null;
        const before=state.slots[record.entry.id];
        if(!item||!(file instanceof TFile)) {
          if(receiveActivity(state,record)){state.slots[record.entry.id]!.needsWrite=true;state.slots[record.entry.id]!.writeBase=before?.value ?? null;}
          await this.save(path,state);continue;
        }
        if(!receiveActivity(state,record))continue;
        let applied=false;
        await this.plugin.app.vault.process(file,content=>{
          const result=applyActivityMarkdown(content,record.entry,before?.value ?? null);
          applied=result.applied;return result.content;
        });
        if(!applied) {
          const now=readActivityMarkdown(await this.plugin.app.vault.read(file),item.id,item.mediaType,false).entries.find(e=>e.id===record.entry.id);
          state.slots[record.entry.id]={value:now ?? {...record.entry,deleted:true},synced:before?.synced ?? null,revision:before?.revision ?? 0,conflict:record};
        }
        // Persist each applied row before advancing the feed. Reapplying after a crash is idempotent.
        await this.save(path,state);
      }
      state.cursor=page.cursor;await this.save(path,state);
      if(!page.hasMore)break;
    }
    const conflicts=Object.values(state.slots).filter(s=>s.conflict).map(s=>`${s.value.id}:${s.conflict!.revision}`).sort().join(',');
    if(conflicts&&conflicts!==this.lastNotice)new Notice('PepeHub: журнал изменён с обеих сторон. Команда «PepeHub: разрешить конфликты журнала» позволяет выбрать версии.');
    this.lastNotice=conflicts;
  }
  async review():Promise<void> {
    const path=await this.statePath(),state=await this.readState(path);
    const conflicts=Object.values(state.slots).filter(s=>s.conflict);
    if(!conflicts.length){new Notice('PepeHub: конфликтов журнала нет.');return;}
    const modal=new Modal(this.plugin.app);modal.titleEl.setText('Конфликты журнала PepeHub');
    for(const slot of conflicts) {
      const remote=slot.conflict!;
      const block=modal.contentEl.createDiv();
      block.createEl('h3',{text:`${slot.value.day} · ${slot.value.mediaType==='book'?'Чтение':'Прослушивание'}`});
      block.createEl('p',{text:`Локально: ${(slot.value.durationMs/60000).toFixed(1)} мин${slot.value.deleted?' (удалено)':''}; сервер: ${(remote.entry.durationMs/60000).toFixed(1)} мин${remote.entry.deleted?' (удалено)':''}`});
      block.createEl('p',{text:`Локальная заметка: ${slot.value.note || '—'}\nСервер: ${remote.entry.note || '—'}`});
      for(const useRemote of [true,false]) {
        const button=block.createEl('button',{text:useRemote?'Взять с сервера':'Оставить локальную'});
        button.onclick=async()=>{
          if(this.busy){new Notice('Синхронизация ещё идёт. Повторите выбор после её завершения.');return;}
          button.disabled=true;this.busy=true;
          try {
            const latest=await this.readState(path),live=latest.slots[slot.value.id];
            if(!live?.conflict||!equalValue(live.value,slot.value))throw new Error('Запись изменилась. Откройте список конфликтов заново.');
            if(useRemote) {
              const files=this.plugin.app.vault.getMarkdownFiles();let found:TFile|undefined;
              for(const file of files){const fm=this.plugin.app.metadataCache.getFileCache(file)?.frontmatter;if(fm?.pepehub_id===slot.value.itemId){found=file;break;}}
              if(!found)throw new Error('Заметка книги не найдена.');
              let applied=false;await this.plugin.app.vault.process(found,content=>{const result=applyActivityMarkdown(content,remote.entry,slot.value);applied=result.applied;return result.content;});
              if(!applied)throw new Error('Строка изменилась. Сначала повторите синхронизацию.');
              live.value=remote.entry;
            }
            live.synced=remote.entry;live.revision=remote.revision;delete live.operation;delete live.conflict;
            await this.save(path,latest);block.remove();
          }catch(error){new Notice(`PepeHub: ${String(error)}`);button.disabled=false;}finally{this.busy=false;}
        };
      }
    }
    modal.open();
  }
}
